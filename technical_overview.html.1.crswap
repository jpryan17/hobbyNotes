<head>
  <meta charset="UTF-8">
  <title>technical_overview</title>
  <style>
    body { font-family: "Times New Roman", Times, Georgia, serif; line-height: 1.6; max-width: 860px; margin: 40px auto; padding: 0 20px; color: #1e293b; }
    h1, h2, h3 { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; color: #0f172a; }
    svg { max-width: 100%; height: auto; display: block; margin: 16px auto; }
    sub { font-size: 0.8em; vertical-align: -0.25em; line-height: 0; }
    sub sub, sub.sub-sub { font-size: 0.72em; vertical-align: -0.36em; line-height: 0; }
    sup { font-size: 0.8em; vertical-align: 0.42em; line-height: 0; }
