{
  "name": "middleway_math",
  "version": "2.0.0",
  "description": "Mathematics and the Middle Way (middlewaymath.app)",
  "scripts": {
    "dev": "node ./nodeUtils/public/startApp1.js",
    "editor": "npm run utilsC && node ./nodeUtils/public/startEditor.js",
    "build": "npm run utilsC && npm run catalog && npm run leanCache && npm run compile && npm run segs && npm run index",
    "build:all": "npm run utilsC && npm run catalog && npm run leanCache:force && npm run compile && npm run segs && npm run index",
    "compile": "cd ./app1 && npx tsc",
    "deploy": "node ./nodeUtils/public/deploy.js",
    "deploy:build": "node ./nodeUtils/public/deploy.js --build",
    "sync:overview": "node -e \"const fs = require('fs'); fs.copyFileSync('overview.html', 'app1/dist/overview.html'); console.log('[sync:overview] overview.html synced to app1/dist/overview.html');\"",
    "leanCache": "node ./nodeUtils/public/genLeanCache.js",
    "leanCache:force": "node ./nodeUtils/public/genLeanCache.js --force",
    "catalog": "node ./nodeUtils/public/buildCatalog.js",
    "stencils": "npm run catalog",
    "survey": "node ./nodeUtils/public/surveySegs.js",
    "leanServer": "node ./leanServer/public/server.js",
    "serverC": "cd ./server && npx tsc",
    "consoleC": "node ./node_modules/esbuild/bin/esbuild console/console.ts --bundle --outfile=console/public/bundle.js --format=esm --sourcemap",
    "console": "npm run utilsC && npm run consoleC && node ./nodeUtils/public/startConsole.js",
    "crudC": "node ./node_modules/esbuild/bin/esbuild crud/src/main.ts --bundle --outfile=crud/public/bundle.js --format=esm --sourcemap",
    "crud": "npm run utilsC && npm run crudC && node ./nodeUtils/public/startCrud.js",
    "server": "node ./server/public/server.js",
    "utilsC": "cd ./nodeUtils && npx tsc",
    "segs": "cd ./nodeUtils && node ./public/genSegsFiles.js",
    "index": "node ./nodeUtils/public/indexBuild.js",
    "db:seed": "npm run utilsC && node ./nodeUtils/public/genSqlSeeds.js",
    "publish:db": "npm run utilsC && node ./nodeUtils/public/dbPublisher.js app1",
    "publish:db:dist": "npm run utilsC && node ./nodeUtils/public/dbPublisher.js app1 index.html dist",
    "dist": "cd ./app1/dist && live-server"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "live-server": "^1.1.0",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.23.1",
    "esbuild": "^0.28.1",
    "typescript": "^7.0.2"
  }
}