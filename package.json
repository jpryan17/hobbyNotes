{
  "name": "my_js_note_apps",
  "version": "1.0.0",
  "description": "dir for myJSnote apps",
  "scripts": {
    "app1C": "cd ./app1 && npx tsc",
    "app1R": "node ./nodeUtils/public/startApp1.js",
    "app1CR": "npm run app1C && npm run app1R",
    "app1DistR": "cd ./app1/dist && live-server",
    "app1BuildR": "npm run app1C && npm run utilsC && npm run segsR && npm run indexR",
    "app2C": "cd ./app2 && npx tsc",
    "app2R": "node ./nodeUtils/public/startApp2.js",
    "app2CR": "npm run app2C && npm run app2R",
    "app2DistR": "cd ./app2/dist && live-server",
    "app2BuildR": "npm run app2C && npm run utilsC && npm run segs2R && npm run index2R",
    "segs2R": "cd ./nodeUtils && node ./public/genSegsFiles.js app2",
    "index2R": "node ./nodeUtils/public/indexBuild.js app2",
    "deploy": "git add . && git commit -m \"Update sharedhallucination notes and demos\" && git push origin master",
    "deploy2": "node ./nodeUtils/public/deployLam.js",
    "deployLAM": "node ./nodeUtils/public/deployLam.js",
    "clientLibC": "cd ./clientLib && npx tsc",
    "utilsC": "cd ./nodeUtils && npx tsc",
    "segsR": "cd ./nodeUtils && node ./public/genSegsFiles.js",
    "ttdRefR": "node ./nodeUtils/public/genTTDRefs.js",
    "fsdRefR": "node ./nodeUtils/public/genFSDRefs.js",
    "btdRefR": "node ./nodeUtils/public/genBTDRefs.js",
    "bidRefR": "node ./nodeUtils/public/genBIDRefs.js",
    "indexR": "node ./nodeUtils/public/indexBuild.js",
    "scriptR": "cd ./app1/dist && node ../../nodeUtils/public/scriptBuild.js",
    "serverC": "cd ./server && npx tsc",
    "serverR": "node ./server/public/server.js",
    "dlbtC": "cd ./djsb/labeledBtree && tsc",
    "dpbtC": "cd ./djsb/projectedBtree && tsc",
    "dbbtC": "cd ./djsb/birthdayBtree && tsc",
    "drbtC": "cd ./djsb/drBtree && tsc",
    "precC": "cd ./djsb/precisionBtree && tsc",
    "simpC": "cd ./djsi/simplicityDiagram && tsc",
    "subC": "cd ./djsi/aSubtree && tsc",
    "cutC": "cd ./djsi/cutDiagram && tsc",
    "opsC": "cd ./djsi/opsDiagram && tsc",
    "test": "cd ./tests/proofBuilder && tsc",
    "testBTreeC": "cd ./tests/testBTree && npx tsc",
    "testBTreeR": "cd ./tests/testBTree && live-server",
    "testCC": "cd ./testC && tsc",
    "testBR": "cd ./testB && live-server",
    "snip": "cd snippet && tsc && node snip.js"
  },
  "dependencies": {
    "live-server": "^1.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "esbuild": "^0.28.1",
    "typescript": "^7.0.2"
  }
}