{
  "name": "middleway_math",
  "version": "2.0.0",
  "description": "Mathematics and the Middle Way (middlewaymath.app)",
  "scripts": {
    "dev": "node ./nodeUtils/public/startApp1.js",
    "d": "npm run dev",
    "compile": "cd ./app1 && npx tsc",
    "c": "npm run compile",
    "build": "npm run utilsC && npm run leanCache && npm run compile && npm run segs && npm run index",
    "b": "npm run build",
    "leanCache": "node ./nodeUtils/public/genLeanCache.js",
    "deploy": "node ./nodeUtils/public/deploy.js",
    "deployMaxCalc": "node ./nodeUtils/public/deployMaxCalc.js",
    "tunnel": "python MaximaMiner/run_tunnel.py",
    "p": "npm run deploy",
    "dist": "cd ./app1/dist && live-server",
    "segs": "cd ./nodeUtils && node ./public/genSegsFiles.js",
    "index": "node ./nodeUtils/public/indexBuild.js",
    "utilsC": "cd ./nodeUtils && npx tsc",
    "clientLibC": "cd ./clientLib && npx tsc",
    "serverC": "cd ./server && npx tsc",
    "server": "node ./server/public/server.js",
    "leanC": "cd ./leanServer && npx tsc",
    "leanServer": "node ./leanServer/public/server.js",
    "ttdRefR": "node ./nodeUtils/public/genTTDRefs.js",
    "fsdRefR": "node ./nodeUtils/public/genFSDRefs.js",
    "btdRefR": "node ./nodeUtils/public/genBTDRefs.js",
    "bidRefR": "node ./nodeUtils/public/genBIDRefs.js",
    "app1BuildR": "npm run build",
    "app1C": "npm run compile",
    "app1R": "npm run dev"
  },
  "dependencies": {
    "live-server": "^1.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "esbuild": "^0.28.1",
    "typescript": "^7.0.2"
  }
}