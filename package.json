{
  "name": "middleway_math",
  "version": "2.0.0",
  "description": "Mathematics and the Middle Way (middlewaymath.app)",
  "scripts": {
    "dev": "npm run app1R",
    "d": "npm run dev",
    "build": "npm run app1BuildR",
    "b": "npm run build",
    "deploy": "git add . && git commit -m \"Deploy Mathematics and the Middle Way to middlewaymath.app\" && git push origin master",
    "p": "npm run deploy",
    "deployLAM": "node ./nodeUtils/public/deployLam.js",
    "app1C": "cd ./app1 && npx tsc",
    "app1R": "node ./nodeUtils/public/startApp1.js",
    "app1CR": "npm run app1C && npm run app1R",
    "app1DistR": "cd ./app1/dist && live-server",
    "app1BuildR": "npm run app1C && npm run utilsC && npm run segsR && npm run indexR",
    "app2C": "cd ./app2 && npx tsc",
    "app2R": "npm run segs2R && node ./nodeUtils/public/startApp2.js",
    "app2CR": "npm run app2C && npm run segs2R && npm run app2R",
    "app2DistR": "cd ./app2/dist && live-server",
    "app2BuildR": "npm run app2C && npm run utilsC && npm run segs2R && npm run index2R",
    "segsR": "cd ./nodeUtils && node ./public/genSegsFiles.js",
    "segs2R": "cd ./nodeUtils && node ./public/genSegsFiles.js app2",
    "indexR": "node ./nodeUtils/public/indexBuild.js",
    "index2R": "node ./nodeUtils/public/indexBuild.js app2",
    "utilsC": "cd ./nodeUtils && npx tsc",
    "clientLibC": "cd ./clientLib && npx tsc",
    "ttdRefR": "node ./nodeUtils/public/genTTDRefs.js",
    "fsdRefR": "node ./nodeUtils/public/genFSDRefs.js",
    "btdRefR": "node ./nodeUtils/public/genBTDRefs.js",
    "bidRefR": "node ./nodeUtils/public/genBIDRefs.js",
    "serverC": "cd ./server && npx tsc",
    "serverR": "node ./server/public/server.js"
  },
  "dependencies": {
    "live-server": "^1.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "esbuild": "^0.28.1",
    "typescript": "^7.0.2"
  }
}