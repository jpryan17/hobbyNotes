 style="font-size: 0px; text-align: center; color: rgb(0, 0, 0);"><div style="display: inline-block; font-size: 12px; font-family: Helvetica; color: var(--ge-adaptive-fg, #000000); line-height: 1.2; pointer-events: all; overflow-wrap: normal;">mathematical<div>reality</div></div></div></div></foreignObject><text x="73" y="232" fill="#000000" font-family="Helvetica" font-size="12px" text-anchor="middle" style="fill: var(--ge-adaptive-fg, #000000);"><tspan x="73" y="232">mathematical</tspan><tspan x="73" y="246">reality</tspan></text></switch></g></g></g><g data-cell-id="u1n8Xw_qIOu34VLNSmKq-11"><g><rect x="420" y="210" width="85" height="50" fill="none" stroke="none" pointer-events="all"></rect></g><g><g><switch><foreignObject style="overflow: visible; text-align: left;" pointer-events="none" width="100%" height="100%" requiredFeatures="http://www.w3.org/TR/SVG11/feature#Extensibility"><div xmlns="http://www.w3.org/1999/xhtml" style="display: flex; align-items: unsafe center; justify-content: unsafe center; width: 83px; height: 1px; padding-top: 235px; margin-left: 421px;"><div style="font-size: 0px; text-align: center; color: rgb(0, 0, 0);"><div style="display: inline-block; font-size: 12px; font-family: Helvetica; color: var(--ge-adaptive-fg, #000000); line-height: 1.2; pointer-events: all; overflow-wrap: normal;">physical<div>reality</div></div></div></div></foreignObject><text x="463" y="232" fill="#000000" font-family="Helvetica" font-size="12px" text-anchor="middle" style="fill: var(--ge-adaptive-fg, #000000);"><tspan x="463" y="232">physical</tspan><tspan x="463" y="246">reality</tspan></text></switch></g></g></g><g data-cell-id="u1n8Xw_qIOu34VLNSmKq-15"><g><rect x="160" y="30" width="50" height="30" fill="none" stroke="none" pointer-events="all"></rect></g><g><g><switch><foreignObject style="overflow: visible; text-align: left;" pointer-events="none" width="100%" height="100%" requiredFeatures="http://www.w3.org/TR/SVG11/feature#Extensibility"><div xmlns="htt