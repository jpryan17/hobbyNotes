{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "outDir": "./public",
    "rootDir": "../../",
    "allowJs": true,
    "strict": false,
    "types": ["node"],
    "skipLibCheck": true,
    "noEmit": false
  },
  "include": [
    "./src/**/*",
    "../../clientLib/**/*",
    "../../nodeUtils/**/*"
  ]
}
